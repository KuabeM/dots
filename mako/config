default-timeout=10000
ignore-timeout=0

# Style (Catppuccin Macchiato)
font=Hack Nerd Font 10
background-color=#24273aEE
text-color=#cad3f5
border-size=2
border-radius=8
border-color=#b7bdf8
progress-color=over #363a4f
height=200
padding=10,14
anchor=bottom-right
outer-margin=60,20

format=<b>%s</b>\n%b\n<small>%a</small>

[urgency=low]
border-color=#5b6078
default-timeout=5000

[urgency=normal]
border-color=#b7bdf8
default-timeout=10000

[urgency=high]
border-color=#ed8796
text-color=#cad3f5
default-timeout=0
